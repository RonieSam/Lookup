# Postgres connection string (Neon's free plan works well: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The password you type on the Admin page to upload data
ADMIN_PASSWORD=choose-a-long-password

# Random string used to sign the admin session cookie (16+ characters).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional: sync placements from Gmail (see the README, "Syncing placements from Gmail")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# MAIL_SYNC_QUERY=subject:"selection list"
