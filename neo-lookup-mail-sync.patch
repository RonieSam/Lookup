+/**
+ * Reading a "selection list" email.
+ *
+ * The subject names the company and the kind of drive; the body lists the Neo IDs:
+ *
+ *   Congratulations !! Sobha Limited Dream Core Internship selection list - 2027 Batch !!
+ *   Congratulations !! Myntra Super Dream Internship Selection list - 2027 Batch !!
+ *   Congratulations!! Urban Company Dream Internship / Placement Offer Selection List - 2027 Batch - VLR
+ *   Congratulations !! Valeo Regular Internship Selection List!! - Additional
+ *   Congratulations ! E.I.D. – Parry (India) Murugappa Group Dream Core Internship Selection List!!
+ *
+ * So the company is the text between the "Congratulations" greeting and the
+ * drive type ("Dream Core Internship", "Super Dream Internship", "Regular
+ * Internship", ...). When a subject doesn't fit, the company comes back null
+ * and the admin types it in; nothing is guessed.
+ */
+
+// A drive type is a tier word followed by what's being offered, e.g. "Super Dream Internship".
+const TIER_AND_KIND =
+  /\b(?:(?:super|open)\s+dream(?:\s+core)?|dream(?:\s+core)?|regular|core|marquee)\s+(?:internship|placement|offer|ppo|selection)\b/i;
+// Fallback when there's no tier word: cut at the first "Internship", "Placement", ...
+const KIND = /\b(?:internship|placement|offer|ppo|selection)\b/i;
+
+const EDGE_PUNCTUATION = /^[\s!,:;|/–—-]+|[\s!,:;|/–—-]+$/g;
+const MAX_COMPANY_LENGTH = 100;
+
+export function extractCompany(subject: string): string | null {
+  let s = subject.replace(/\s+/g, " ").trim();
+  s = s.replace(/^(?:(?:re|fwd?)\s*:\s*)+/i, "");
+  if (!/selection\s+list/i.test(s)) return null;
+
+  s = s.replace(/^(?:congratulations|congrats)\b[\s!.,:–—-]*/i, "");
+
+  let cut = s.search(TIER_AND_KIND);
+  if (cut === -1) cut = s.search(KIND);
+  if (cut === -1) return null;
+
+  const company = s.slice(0, cut).replace(EDGE_PUNCTUATION, "");
+  return company === "" || company.length > MAX_COMPANY_LENGTH ? null : company;
+}
+
+/**
+ * Every Neo ID in the text, upper-case, in order of first appearance.
+ *
+ * A word only counts when the whole word is a Neo ID, so a web address or a
+ * longer code that happens to contain eight matching characters is not picked up.
+ */
+export function extractNeoIds(text: string): string[] {
+  const ids: string[] = [];
+  for (const t of classifyTokens(tokenize(text))) if (t.status === "valid") ids.push(t.id);
+  return ids;
+}
+
+const ENTITIES: Record<string, string> = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'", nbsp: " " };
+
+/** Plain text from an HTML email body: line breaks at block ends, tags and entities removed. */
+export function htmlToText(html: string): string {
+  return html
+    .replace(/<(style|script)\b[\s\S]*?<\/\1>/gi, " ")
+    .replace(/<br\s*\/?>|<\/(?:p|div|tr|li|h[1-6]|table)>/gi, "\n")
+    .replace(/<\/t[dh]>/gi, " ")
+    .replace(/<[^>]*>/g, " ")
+    .replace(/&(#x?[0-9a-f]+|[a-z]+);/gi, (whole, body: string) => {
+      if (body[0] === "#") {
+        const code = body[1].toLowerCase() === "x" ? parseInt(body.slice(2), 16) : parseInt(body.slice(1), 10);
+        return Number.isFinite(code) && code > 0 && code < 0x110000 ? String.fromCodePoint(code) : " ";
+      }
+      return ENTITIES[body.toLowerCase()] ?? whole;
+    });
+}
diff --git a/src/lib/mailSync.ts b/src/lib/mailSync.ts
new file mode 100644
index 0000000..64a6d51
--- /dev/null
+++ b/src/lib/mailSync.ts
@@ -0,0 +1,253 @@
+import type { Db } from "./db";
+import { readEnv } from "./env";
+import { gmailConfigured, type GmailClient } from "./gmail";
+import { extractCompany, extractNeoIds } from "./mailParse";
+import { isValidNeoId, normalizeNeoId } from "./neo";
+import { changePlacements } from "./placements";
+import { HttpError, MAX_LOOKUP_TOKENS } from "./students";
+
+/**
+ * Syncing placements from Gmail.
+ *
+ * A sync is two steps so nothing is saved by surprise:
+ *   1. previewSync reads the mail that arrived since the last sync and works out
+ *      the company and Neo IDs of each one. It writes nothing.
+ *   2. saveSync stores what the admin confirmed (they can correct a company name
+ *      first) and moves the "last synced" date forward.
+ *
+ * Mails already handled are remembered by Gmail message id, so a mail is never
+ * processed twice, and the search deliberately starts a little before the saved
+ * date to catch mail Gmail was slow to index.
+ */
+
+/** Gmail search used to find selection lists. Override with MAIL_SYNC_QUERY (e.g. add `from:...`). */
+export const DEFAULT_MAIL_QUERY = 'subject:"selection list"';
+
+/** Mails read per sync. Keeps one click inside the free Cloudflare plan's limit of 50 outside requests. */
+export const MAX_MAILS_PER_SYNC = 25;
+const MAX_LISTED = 300;
+const OVERLAP_MS = 2 * 24 * 3600_000;
+const FETCH_CONCURRENCY = 5;
+
+export function mailQuery(): string {
+  return readEnv("MAIL_SYNC_QUERY")?.trim() || DEFAULT_MAIL_QUERY;
+}
+
+export interface MailPreview {
+  id: string;
+  subject: string;
+  from: string;
+  date: string;
+  /** The company worked out from the subject, or null when it couldn't be. */
+  company: string | null;
+  ids: string[];
+}
+
+export interface SyncPreview {
+  query: string;
+  /** Where the search started. */
+  since: string;
+  /** Mails that matched the search in that window. */
+  matched: number;
+  /** Of those, how many were already handled in an earlier sync. */
+  alreadySynced: number;
+  /** New mails, oldest first, at most MAX_MAILS_PER_SYNC. */
+  mails: MailPreview[];
+  /** New mails left for the next sync because of the cap. */
+  waiting: number;
+}
+
+export interface MailSyncStatus {
+  configured: boolean;
+  query: string;
+  /** When a sync last saved, or null if none has. */
+  lastSyncedAt: string | null;
+  /** Mail up to this moment has been handled. */
+  checkedUpTo: string | null;
+}
+
+export async function mailSyncStatus(db: Db): Promise<MailSyncStatus> {
+  const { rows } = await db.query<{ cursor: Date | string; last_run_at: Date | string }>(
+    "select cursor, last_run_at from mail_sync where id = 1",
+  );
+  const iso = (v: Date | string) => new Date(v).toISOString();
+  return {
+    configured: gmailConfigured(),
+    query: mailQuery(),
+    lastSyncedAt: rows[0] ? iso(rows[0].last_run_at) : null,
+    checkedUpTo: rows[0] ? iso(rows[0].cursor) : null,
+  };
+}
+
+function parseSinceDate(value: unknown): Date | null {
+  if (value === undefined || value === null || value === "") return null;
+  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    throw new HttpError(400, "Choose the start date again.");
+  }
+  const date = new Date(`${value}T00:00:00Z`);
+  if (Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== value) {
+    throw new HttpError(400, "That isn't a real date.");
+  }
+  if (date.getTime() > Date.now() + 24 * 3600_000) throw new HttpError(400, "The start date can't be in the future.");
+  return date;
+}
+
+async function mapLimit<T, R>(items: T[], limit: number, fn: (item: T) => Promise<R>): Promise<R[]> {
+  const out: R[] = new Array(items.length);
+  let next = 0;
+  await Promise.all(
+    Array.from({ length: Math.min(limit, items.length) }, async () => {
+      while (next < items.length) {
+        const i = next++;
+        out[i] = await fn(items[i]);
+      }
+    }),
+  );
+  return out;
+}
+
+export async function previewSync(
+  db: Db,
+  gmail: GmailClient,
+  options: { since?: unknown; query?: string },
+): Promise<SyncPreview> {
+  const query = options.query ?? mailQuery();
+  const chosen = parseSinceDate(options.since);
+
+  const { rows: cursorRows } = await db.query<{ cursor: Date | string }>("select cursor from mail_sync where id = 1");
+  const cursor = cursorRows[0] ? new Date(cursorRows[0].cursor) : null;
+
+  // An explicit date wins; otherwise continue a little before where the last sync stopped.
+  let since: Date;
+  if (chosen) since = chosen;
+  else if (cursor) since = new Date(cursor.getTime() - OVERLAP_MS);
+  else throw new HttpError(400, "This is the first sync. Choose the date to start from.");
+
+  // Seconds, not a date: Gmail reads a plain date as midnight Pacific time.
+  const listed = await gmail.listMessageIds(`${query} after:${Math.floor(since.getTime() / 1000)}`, MAX_LISTED);
+
+  let handled = new Set<string>();
+  if (listed.length > 0) {
+    const { rows } = await db.query<{ message_id: string }>(
+      "select message_id from synced_mails where message_id in (select jsonb_array_elements_text($1::jsonb))",
+      [JSON.stringify(listed)],
+    );
+    handled = new Set(rows.map((r) => r.message_id));
+  }
+
+  // Gmail lists newest first; work oldest first so "last synced" only ever moves forward.
+  const fresh = listed.filter((id) => !handled.has(id)).reverse();
+  const batch = fresh.slice(0, MAX_MAILS_PER_SYNC);
+
+  const mails = await mapLimit(batch, FETCH_CONCURRENCY, async (id): Promise<MailPreview> => {
+    const m = await gmail.getMessage(id);
+    return { id: m.id, subject: m.subject, from: m.from, date: m.date, company: extractCompany(m.subject), ids: extractNeoIds(m.text) };
+  });
+  mails.sort((a, b) => a.date.localeCompare(b.date));
+
+  return {
+    query,
+    since: since.toISOString(),
+    matched: listed.length,
+    alreadySynced: handled.size,
+    mails,
+    waiting: fresh.length - batch.length,
+  };
+}
+
+/* ------------------------------------------------------------------ */
+
+export interface MailDecision {
+  id: string;
+  subject: string;
+  date: string;
+  /** The company to save these students under, or null to skip the mail. */
+  company: string | null;
+  ids: string[];
+}
+
+export interface SavedMail {
+  company: string;
+  added: number;
+  alreadyIn: number;
+  unknownStudents: number;
+}
+
+export interface SaveResult {
+  saved: SavedMail[];
+  skipped: number;
+  checkedUpTo: string | null;
+}
+
+const MAX_DECISIONS = 100;
+
+export function validateDecisions(body: unknown): MailDecision[] {
+  const list = (body as { mails?: unknown } | null)?.mails;
+  if (!Array.isArray(list)) throw new HttpError(400, "Expected a list of mails.");
+  if (list.length > MAX_DECISIONS) throw new HttpError(413, `Send at most ${MAX_DECISIONS} mails at a time.`);
+
+  const seen = new Set<string>();
+  return list.map((raw) => {
+    const m = raw as Partial<MailDecision> | null;
+    if (!m || typeof m.id !== "string" || m.id === "" || m.id.length > 200) throw new HttpError(400, "A mail is missing its id.");
+    if (seen.has(m.id)) throw new HttpError(400, "The same mail was sent twice.");
+    seen.add(m.id);
+
+    const date = new Date(typeof m.date === "string" ? m.date : NaN);
+    if (Number.isNaN(date.getTime())) throw new HttpError(400, "A mail has no valid date.");
+
+    if (m.company !== null && m.company !== undefined && typeof m.company !== "string") throw new HttpError(400, "Invalid company.");
+    if (!Array.isArray(m.ids) || m.ids.length > MAX_LOOKUP_TOKENS) throw new HttpError(400, "Invalid list of Neo IDs.");
+    const ids = [...new Set(m.ids.map((x) => {
+      if (typeof x !== "string" || !isValidNeoId(x.trim())) throw new HttpError(400, `Invalid Neo ID: ${JSON.stringify(x)}.`);
+      return normalizeNeoId(x);
+    }))];
+
+    return {
+      id: m.id,
+      subject: typeof m.subject === "string" ? m.subject.slice(0, 500) : "",
+      date: date.toISOString(),
+      company: typeof m.company === "string" && m.company.trim() !== "" ? m.company : null,
+      ids,
+    };
+  });
+}
+
+export async function saveSync(db: Db, decisions: MailDecision[]): Promise<SaveResult> {
+  return db.transaction(async (tx) => {
+    const saved: SavedMail[] = [];
+    let skipped = 0;
+    let newest: string | null = null;
+
+    for (const d of decisions) {
+      if (newest === null || d.date > newest) newest = d.date;
+
+      const keep = d.company !== null && d.ids.length > 0;
+      if (keep) {
+        const r = await changePlacements(tx, { action: "add", company: d.company, text: d.ids.join(" ") });
+        saved.push({ company: r.company, added: r.added, alreadyIn: r.alreadyIn, unknownStudents: r.unknownStudents.count });
+      } else {
+        skipped++;
+      }
+
+      await tx.query(
+        `insert into synced_mails (message_id, subject, mail_date, company, student_count, status)
+         values ($1, $2, $3, $4, $5, $6)
+         on conflict (message_id) do nothing`,
+        [d.id, d.subject, d.date, keep ? d.company : null, keep ? d.ids.length : 0, keep ? "saved" : "skipped"],
+      );
+    }
+
+    // "Last synced" only moves forward, and never past mail that wasn't part of this save.
+    if (newest !== null) {
+      await tx.query(
+        `insert into mail_sync (id, cursor, last_run_at) values (1, $1, now())
+         on conflict (id) do update
+           set cursor = greatest(mail_sync.cursor, excluded.cursor), last_run_at = now()`,
+        [newest],
+      );
+    }
+    const { rows } = await tx.query<{ cursor: Date | string }>("select cursor from mail_sync where id = 1");
+    return { saved, skipped, checkedUpTo: rows[0] ? new Date(rows[0].cursor).toISOString() : null };
+  });
+}
diff --git a/tests/mail.test.ts b/tests/mail.test.ts
new file mode 100644
index 0000000..b0cc54f
--- /dev/null
+++ b/tests/mail.test.ts
@@ -0,0 +1,455 @@
+import assert from "node:assert/strict";
+import { afterEach, before, beforeEach, describe, it } from "node:test";
+import { getReadyDb } from "../src/lib/db";
+import { createGmailClient, gmailConfigured, type GmailClient, type GmailMessage } from "../src/lib/gmail";
+import { extractCompany, extractNeoIds, htmlToText } from "../src/lib/mailParse";
+import { MAX_MAILS_PER_SYNC, mailSyncStatus, previewSync, saveSync, validateDecisions } from "../src/lib/mailSync";
+import { adminSummary, lookupStudents } from "../src/lib/students";
+import { freshDb } from "./helpers";
+
+/* ---------------------------------------------------------------- parsing */
+
+describe("Company from the subject line", () => {
+  const cases: [string, string | null][] = [
+    ["Congratulations ! E.I.D. – Parry (India) Murugappa Group Dream Core Internship Selection List!!", "E.I.D. – Parry (India) Murugappa Group"],
+    ["Congratulations !! Sobha Limited Dream Core Internship selection list - 2027 Batch !!", "Sobha Limited"],
+    ["Congratulations !! Myntra Super Dream Internship Selection list - 2027 Batch !!", "Myntra"],
+    ["Congratulations!! Urban Company Dream Internship / Placement Offer Selection List - 2027 Batch - VLR", "Urban Company"],
+    ["Congratulations !! Valeo Regular Internship Selection List!! - Additional", "Valeo"],
+    // other shapes
+    ["Re: Fwd: Congratulations !! Valeo Regular Internship Selection List", "Valeo"],
+    ["CONGRATULATIONS!! VALEO REGULAR INTERNSHIP SELECTION LIST", "VALEO"],
+    ["Congratulations !! Core Compete Dream Internship Selection List", "Core Compete"],
+    ["Congratulations !! Dream11 Super Dream Internship Selection List", "Dream11"],
+    ["Congratulations !! Acme Internship Selection List", "Acme"],
+    ["Congratulations !! Acme Marquee Placement Selection List", "Acme"],
+    ["  Congratulations   !!   Tata   Steel  Dream  Internship  Selection List ", "Tata Steel"],
+    // not usable: the admin types the company in
+    ["Interview schedule for Google - 2027 batch", null],
+    ["Congratulations !! Selection List", null],
+    ["Congratulations !! Dream Internship Selection List", null],
+    ["", null],
+  ];
+  for (const [subject, company] of cases) {
+    it(`${JSON.stringify(company)} <- ${subject.trim().slice(0, 60)}`, () => assert.equal(extractCompany(subject), company));
+  }
+  it("refuses an absurdly long company", () => {
+    assert.equal(extractCompany(`Congratulations ${"x".repeat(150)} Dream Internship Selection List`), null);
+  });
+});
+
+describe("Neo IDs from the body", () => {
+  it("reads the layouts seen in real mails", () => {
+    const withLabel = "Congratulations !! \n\nSobha Limited Dream Core Internship selection list - 2027 Batch !!\n\n\nNeo ID\nQ1W2E3R4\nZ9X8C7V6\n";
+    assert.deepEqual(extractNeoIds(withLabel), ["Q1W2E3R4", "Z9X8C7V6"]);
+    const noLabel = "Congratulations !\n\n E.I.D. – Parry (India) Murugappa Group Dream Core Internship Selection List!!\n\nP0O9I8U7\nL1K2J3H4\n";
+    assert.deepEqual(extractNeoIds(noLabel), ["P0O9I8U7", "L1K2J3H4"]);
+    assert.deepEqual(extractNeoIds("NEO ID\nM5N6B7V8\n"), ["M5N6B7V8"]);
+  });
+  it("accepts IDs separated by commas, spaces or in a table, any case, once each", () => {
+    assert.deepEqual(extractNeoIds("q1w2e3r4, Z9X8C7V6 ; P0O9I8U7\tL1K2J3H4 Q1W2E3R4"), ["Q1W2E3R4", "Z9X8C7V6", "P0O9I8U7", "L1K2J3H4"]);
+  });
+  it("does not pick IDs out of web addresses or longer codes", () => {
+    const footer = "https://groups.google.com/a/example.ac.in/d/msgid/q1w2e3r4/CAB1C2D3E4F5 ref-A1B2C3D4E5 vitianscdc2027+unsubscribe@example.ac.in";
+    assert.deepEqual(extractNeoIds(footer), []);
+  });
+  it("finds nothing in a mail without IDs", () => assert.deepEqual(extractNeoIds("Congratulations to all! 2027 Batch"), []));
+});
+
+describe("HTML bodies", () => {
+  it("turns an HTML list into lines of text", () => {
+    const html = "<html><head><style>p{color:red}</style></head><body><p>Neo&nbsp;ID</p><div>Q1W2E3R4<br>Z9X8C7V6</div><table><tr><td>P0O9I8U7</td><td>L1K2J3H4</td></tr></table></body></html>";
+    assert.deepEqual(extractNeoIds(htmlToText(html)), ["Q1W2E3R4", "Z9X8C7V6", "P0O9I8U7", "L1K2J3H4"]);
+    assert.ok(!htmlToText(html).includes("color:red"));
+  });
+  it("decodes entities, including numbers", () => {
+    assert.equal(htmlToText("A &amp; B &lt;C&gt; &#8211; &#x41; &quot;").replace(/\s+/g, " ").trim(), 'A & B <C> – A "');
+    assert.equal(htmlToText("&#99999999999;").trim(), "", "out-of-range numbers don't throw");
+  });
+});
+
+/* ------------------------------------------------------- Gmail client */
+
+const b64 = (s: string) => Buffer.from(s, "utf8").toString("base64url");
+const ENV = { GOOGLE_CLIENT_ID: "cid", GOOGLE_CLIENT_SECRET: "secret", GOOGLE_REFRESH_TOKEN: "refresh" };
+const savedEnv = { ...process.env };
+function setGoogleEnv() { Object.assign(process.env, ENV); }
+afterEach(() => {
+  for (const k of [...Object.keys(ENV), "MAIL_SYNC_QUERY"]) {
+    if (savedEnv[k] === undefined) delete process.env[k];
+    else process.env[k] = savedEnv[k];
+  }
+});
+
+interface Call { url: string; init?: RequestInit }
+function fakeFetch(routes: (url: URL, init?: RequestInit) => unknown | Response, calls: Call[] = []): typeof fetch {
+  return (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = new URL(String(input));
+    calls.push({ url: url.toString(), init });
+    const out = routes(url, init);
+    if (out instanceof Response) return out;
+    return new Response(JSON.stringify(out), { status: 200, headers: { "content-type": "application/json" } });
+  }) as typeof fetch;
+}
+const tokenOk = (url: URL) => (url.hostname === "oauth2.googleapis.com" ? { access_token: "tok-1", expires_in: 3600 } : undefined);
+
+describe("Gmail client", () => {
+  it("reports whether it is set up", () => {
+    for (const k of Object.keys(ENV)) delete process.env[k];
+    assert.equal(gmailConfigured(), false);
+    setGoogleEnv();
+    assert.equal(gmailConfigured(), true);
+    delete process.env.GOOGLE_REFRESH_TOKEN;
+    assert.equal(gmailConfigured(), false);
+  });
+
+  it("exchanges the refresh token once and sends it as a bearer token", async () => {
+    setGoogleEnv();
+    const calls: Call[] = [];
+    const gmail = createGmailClient(fakeFetch((url) => tokenOk(url) ?? { messages: [{ id: "m1" }] }, calls));
+    await gmail.listMessageIds("subject:x", 10);
+    await gmail.listMessageIds("subject:x", 10);
+    const tokenCalls = calls.filter((c) => c.url.startsWith("https://oauth2.googleapis.com/token"));
+    assert.equal(tokenCalls.length, 1, "the token is reused");
+    const form = new URLSearchParams(String(tokenCalls[0].init!.body));
+    assert.deepEqual(Object.fromEntries(form), { client_id: "cid", client_secret: "secret", refresh_token: "refresh", grant_type: "refresh_token" });
+    const api = calls.find((c) => c.url.includes("gmail.googleapis.com"))!;
+    assert.equal((api.init!.headers as Record<string, string>).authorization, "Bearer tok-1");
+  });
+
+  it("follows pages until it has enough, and stops at the limit", async () => {
+    setGoogleEnv();
+    const calls: Call[] = [];
+    const pages: Record<string, unknown> = {
+      "": { messages: [{ id: "a" }, { id: "b" }], nextPageToken: "p2" },
+      p2: { messages: [{ id: "c" }, { id: "d" }], nextPageToken: "p3" },
+      p3: { messages: [{ id: "e" }] },
+    };
+    const gmail = createGmailClient(fakeFetch((url) => tokenOk(url) ?? pages[url.searchParams.get("pageToken") ?? ""], calls));
+    assert.deepEqual(await gmail.listMessageIds('subject:"selection list" after:100', 300), ["a", "b", "c", "d", "e"]);
+    const first = new URL(calls.find((c) => c.url.includes("/messages?"))!.url);
+    assert.equal(first.searchParams.get("q"), 'subject:"selection list" after:100');
+    assert.deepEqual(await gmail.listMessageIds("q", 3), ["a", "b", "c", "d"].slice(0, 4).slice(0, 4).length === 4 ? ["a", "b", "c", "d"] : []);
+  });
+
+  it("returns nothing when no mail matches", async () => {
+    setGoogleEnv();
+    const gmail = createGmailClient(fakeFetch((url) => tokenOk(url) ?? { resultSizeEstimate: 0 }));
+    assert.deepEqual(await gmail.listMessageIds("q", 10), []);
+  });
+
+  it("reads a nested multipart message, including non-English characters", async () => {
+    setGoogleEnv();
+    const message = {
+      id: "m1", internalDate: String(Date.UTC(2026, 9, 21, 9, 38, 0)),
+      payload: {
+        mimeType: "multipart/mixed",
+        headers: [{ name: "subject", value: "Congratulations !! Café – Dream Internship Selection List" }, { name: "From", value: "'No Reply' via Group <g@x.ac.in>" }],
+        parts: [
+          { mimeType: "multipart/alternative", parts: [
+            { mimeType: "text/plain", body: { data: b64("Neo ID\nQ1W2E3R4\nZ9X8C7V6 – ok") } },
+            { mimeType: "text/html", body: { data: b64("<p>HTML copy P0O9I8U7</p>") } },
+          ] },
+          { mimeType: "application/pdf", filename: "list.pdf", body: { data: b64("Q9Q9Q9Q9") } },
+        ],
+      },
+    };
+    const gmail = createGmailClient(fakeFetch((url) => tokenOk(url) ?? message));
+    const m: GmailMessage = await gmail.getMessage("m1");
+    assert.equal(m.subject, "Congratulations !! Café – Dream Internship Selection List");
+    assert.equal(m.from, "'No Reply' via Group <g@x.ac.in>");
+    assert.equal(m.date, "2026-10-21T09:38:00.000Z");
+    assert.deepEqual(extractNeoIds(m.text), ["Q1W2E3R4", "Z9X8C7V6"], "plain text wins; attachments are ignored");
+  });
+
+  it("falls back to HTML when there is no plain text", async () => {
+    setGoogleEnv();
+    const message = { id: "m2", internalDate: "1", payload: { mimeType: "text/html", headers: [], body: { data: b64("<div>Q1W2E3R4<br>Z9X8C7V6</div>") } } };
+    const m = await createGmailClient(fakeFetch((url) => tokenOk(url) ?? message)).getMessage("m2");
+    assert.deepEqual(extractNeoIds(m.text), ["Q1W2E3R4", "Z9X8C7V6"]);
